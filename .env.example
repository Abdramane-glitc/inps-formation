# =============================================================================
#  Application de gestion des formations — INPS (Mali)
#  Copier ce fichier en « .env » puis compléter. NE JAMAIS versionner le .env.
#  Aucune valeur ci-dessous n'est un secret réel.
# =============================================================================

APP_NAME="Gestion des formations INPS"
# local (développement) | staging (recette) | production
APP_ENV=local
# Générée par : php artisan key:generate
APP_KEY=
# OBLIGATOIREMENT false en production
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Bamako
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# HTTPS forcé (true en production : redirections, cookies sécurisés, HSTS)
FORCE_HTTPS=false
# Adresses des proxys inverses de confiance, séparées par des virgules (ex. 127.0.0.1)
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily : un fichier par jour, conservé LOG_DAILY_DAYS jours
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
# debug en développement, warning en production
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inps_formation
DB_USERNAME=inps_formation
DB_PASSWORD=

# Sessions : stockées en base, chiffrées, expirées après inactivité (minutes)
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Les notifications sont envoyées de manière synchrone : aucun processus de file d'attente requis.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Sécurité des comptes
LOGIN_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=12
# Vérification des mots de passe compromis (service en ligne « Have I Been Pwned ») : nécessite Internet
PASSWORD_CHECK_PWNED=false

# Messagerie. « log » = AUCUN envoi réel (les e-mails ne sont pas remis).
# Pour un envoi réel : MAIL_MAILER=smtp + paramètres du serveur de l'INPS, puis activer
# « Envoyer aussi les notifications par e-mail » dans Administration > Paramètres.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="formation@exemple.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Sauvegardes (php artisan inps:sauvegarde)
BACKUP_PATH=
# Phrase secrète de chiffrement AES-256 des archives (OBLIGATOIRE en production, à conserver hors serveur)
BACKUP_PASSWORD=
BACKUP_RETENTION=14
# Chemins des clients MySQL si absents du PATH (Windows : C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe)
MYSQLDUMP_PATH=mysqldump
MYSQL_CLIENT_PATH=mysql

VITE_APP_NAME="${APP_NAME}"
